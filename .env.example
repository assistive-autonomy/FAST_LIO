# Image and container build settings
FAST_LIO_IMAGE=fast-lio2-humble:local
CONTAINER_USER=ros
USER_UID=1000
USER_GID=1000

# Host directories mounted at /bags (read-only) and /data (writable)
BAG_DIR=./bags
OUTPUT_DIR=./data

# ROS 2 and RViz settings
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
DISPLAY=:0
LIBGL_ALWAYS_SOFTWARE=1
